{
  "expo": {
    "name": "BölBölÖde",
    "slug": "bolbolode",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bolbolode.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bolbolode.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "scheme": "bolbolode",
    "plugins": [],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
